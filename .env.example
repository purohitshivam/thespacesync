# ==============================================================================
# SPACESYNC ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env.local and provide real credentials.
# NEVER commit .env.local or real secrets to version control.
# ==============================================================================

# 1. Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 2. Supabase Configuration (Required for Auth, PostgreSQL, Storage & Realtime)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-publishable-anon-key"

# Server-Only Supabase Service Role Key (Required only for privileged server actions
# such as account deletion and webhook subscription fulfilment; NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# 3. Admin Access Configuration
# Comma-separated list of verified user emails authorised to access /admin
SPACESYNC_ADMIN_EMAILS="admin@spacesync.in"

# 4. Razorpay Payment Integration (Optional — Required for ₹199/month Premium checkout)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_signing_secret"

# 5. Microsoft Clarity Analytics (Optional)
NEXT_PUBLIC_CLARITY_PROJECT_ID="your_clarity_project_id"

